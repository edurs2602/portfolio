# ─── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/portfolio.db

# ─── JWT Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-strong-password

# ─── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=mail.luiseduardo.dev.br
SMTP_PORT=587
SMTP_USER=contato@luiseduardo.dev.br
SMTP_PASSWORD=your-password
CONTACT_EMAIL=contato@luiseduardo.dev.br

# ─── CORS & Security ────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost,https://luiseduardo.dev.br
TRUSTED_HOSTS=localhost,luiseduardo.dev.br,*.luiseduardo.dev.br

# ─── Production ─────────────────────────────────────────────
# Set to true to hide /docs, /redoc, /openapi.json
HIDE_DOCS=false

# ─── Rate Limiting ──────────────────────────────────────────
CONTACT_RATE_LIMIT=3/minute
LOGIN_RATE_LIMIT=5/minute
GLOBAL_RATE_LIMIT=60/minute
